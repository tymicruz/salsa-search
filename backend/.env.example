# Copy this file to .env and fill in your own values. .env is never committed.

# Which LLM /classify uses: gemini (AI Studio key, default), vertex (Google Cloud login, no key) or openai
LLM_PROVIDER=gemini

# Vertex AI (only if LLM_PROVIDER=vertex): your Google Cloud project ID, and "global" as the location.
# No key: log in once with `gcloud auth application-default login` (see README).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Pinned cheap model, used by both gemini and vertex. If you change it, also update the prices in src/llm.ts.
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (for LLM_PROVIDER=openai or npm run compare): create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
# Pinned cheap model. If you change it, also update the prices in src/llm.ts.
OPENAI_MODEL=gpt-6-luna

# Port the backend listens on
PORT=3000
