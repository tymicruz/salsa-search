# Copy this file to .env and fill in your own values. .env is never committed.

# Which LLM /synthesize uses: claude-cli or codex-cli (your Claude / ChatGPT subscription, local only),
# gemini (AI Studio key), vertex (Google Cloud login, no key) or openai
LLM_PROVIDER=claude-cli

# claude-cli: runs `claude -p` from Claude Code. Model alias, and the path to claude if it isn't on your PATH.
CLAUDE_MODEL=haiku
CLAUDE_BIN=claude

# codex-cli: runs `codex exec` (log in first with `codex login`). Empty model = Codex's default.
CODEX_MODEL=
CODEX_BIN=codex

# Vertex AI (only if LLM_PROVIDER=vertex): your Google Cloud project ID, and "global" as the location.
# No key: log in once with `gcloud auth application-default login` (see README).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Pinned cheap model, used by both gemini and vertex. If you change it, also update the prices in src/llm.ts.
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (only if LLM_PROVIDER=openai): create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
# Pinned cheap model. If you change it, also update the prices in src/llm.ts.
OPENAI_MODEL=gpt-6-luna

# Apify (Instagram evidence): your API token from https://console.apify.com/settings/integrations
APIFY_TOKEN=your-apify-token-here
# Most Instagram profiles scraped per day ($0.0026 each, so 30 = about $0.08/day)
APIFY_MAX_PER_DAY=30

# Port the backend listens on
PORT=3000
