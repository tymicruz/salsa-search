# Copy this file to .env and fill in your own values. .env is never committed.

# Which LLM /classify uses: gemini (default) or openai
LLM_PROVIDER=gemini

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# "gemini-flash-latest" always points to Google's newest Flash model
GEMINI_MODEL=gemini-flash-latest

# OpenAI (only if LLM_PROVIDER=openai): create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=

# Port the backend listens on
PORT=3000
